# Copy to .env and replace every placeholder before first startup.
APP_ENV=development
# Generate a stable private key, for example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-key
DEMO_ADMIN_PASSWORD=replace-with-a-private-password-at-least-16-characters
DEMO_ADMIN_EMAIL=
APAAR_DB_PATH=instance/apaar_demo.db
COOKIE_SECURE=0
# Keep provider unset for normal local development. "mock" is synthetic only.
APAAR_PROVIDER=

# Opt-in only for isolated synthetic-data demos; ignored in production mode.
ENABLE_SHARED_DEMO_RECONCILIATION=0
# Optional for local development; configure for email OTP delivery and production.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
